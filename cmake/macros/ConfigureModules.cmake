# Dynamic module discovery and build helpers.
function(GetModuleList output)
  file(GLOB children RELATIVE "${CMAKE_SOURCE_DIR}/modules" "${CMAKE_SOURCE_DIR}/modules/*")
  set(result)
  foreach(child IN LISTS children)
    if(EXISTS "${CMAKE_SOURCE_DIR}/modules/${child}/CMakeLists.txt")
      list(APPEND result "${child}")
    endif()
  endforeach()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(ModuleNameToVariable name output)
  string(TOUPPER "${name}" upper)
  string(REGEX REPLACE "[^A-Z0-9]" "_" upper "${upper}")
  set(${output} "MODULE_${upper}" PARENT_SCOPE)
endfunction()

# Extends the existing script linkage decision before core targets are created.
function(IsDynamicLinkingRequired output)
  set(required OFF)
  if(SCRIPTS MATCHES "dynamic")
    set(required ON)
  endif()
  GetScriptModuleList(modules)
  foreach(module IN LISTS modules)
    ScriptModuleNameToVariable(${module} variable)
    if(DEFINED ${variable})
      if("${${variable}}" STREQUAL "dynamic")
        set(required ON)
      endif()
    endif()
  endforeach()
  GetModuleList(modules)
  foreach(module IN LISTS modules)
    ModuleNameToVariable(${module} variable)
    if(DEFINED ${variable})
      if("${${variable}}" STREQUAL "dynamic")
        set(required ON)
      endif()
    endif()
  endforeach()
  set(${output} ${required} PARENT_SCOPE)
endfunction()

function(trinity_add_module)
  cmake_parse_arguments(M "" "NAME;MANIFEST" "SOURCES;CONFIG;SQL;INCLUDE_DIRS" ${ARGN})
  if(NOT M_NAME OR NOT M_MANIFEST OR NOT M_SOURCES)
    message(FATAL_ERROR "trinity_add_module requires NAME, MANIFEST and SOURCES")
  endif()
  ModuleNameToVariable("${M_NAME}" mode)
  if(NOT DEFINED ${mode})
    set(${mode} "dynamic" CACHE STRING "Build type of the ${M_NAME} module.")
    set_property(CACHE ${mode} PROPERTY STRINGS dynamic disabled)
  endif()
  if("${${mode}}" STREQUAL "disabled")
    return()
  endif()
  if(NOT "${${mode}}" STREQUAL "dynamic")
    message(FATAL_ERROR "${mode} must be dynamic or disabled")
  endif()
  if(NOT TARGET Trinity::SDK)
    find_package(TrinitySDK CONFIG REQUIRED)
  endif()
  if(NOT BUILD_SHARED_LIBS)
    message(FATAL_ERROR "Dynamic modules require a shared core SDK")
  endif()
  file(READ "${M_MANIFEST}" manifest)
  string(JSON version GET "${manifest}" version)
  string(JSON name GET "${manifest}" name)
  if(NOT "${name}" STREQUAL "${M_NAME}")
    message(FATAL_ERROR "Module NAME must match its manifest")
  endif()

  string(REGEX REPLACE "[^a-zA-Z0-9_]" "_" safe "${M_NAME}")
  set(target "module_${safe}")
  string(REPLACE "\\" "\\\\" manifest_cpp "${manifest}")
  string(REPLACE "\"" "\\\"" manifest_cpp "${manifest_cpp}")
  string(REPLACE "\r" "\\r" manifest_cpp "${manifest_cpp}")
  string(REPLACE "\n" "\\n" manifest_cpp "${manifest_cpp}")
  set(metadata_header "${CMAKE_CURRENT_BINARY_DIR}/${safe}_module_build.h")
  file(GENERATE OUTPUT "${metadata_header}" CONTENT
    "#pragma once\n#define TRINITY_MODULE_MANIFEST \"${manifest_cpp}\"\n")
  add_library(${target} SHARED ${M_SOURCES})
  target_link_libraries(${target} PRIVATE Trinity::SDK)
  if(TARGET game)
    # Modules call core exports; an interface-only dependency cannot supply them.
    target_link_libraries(${target} PRIVATE game trinity-core-interface)
  endif()
  target_include_directories(${target} PRIVATE ${M_INCLUDE_DIRS})
  target_compile_definitions(${target} PRIVATE
    TRINITY_MODULE_SHARED
    TRINITY_MODULE_NAME="${M_NAME}"
    TRINITY_MODULE_VERSION="${version}")
  if(MSVC)
    target_compile_options(${target} PRIVATE "/FI${metadata_header}")
  else()
    target_compile_options(${target} PRIVATE "-include${metadata_header}")
  endif()
  set(resource "${CMAKE_BINARY_DIR}/bin/$<CONFIG>/modules/${M_NAME}")
  set_target_properties(${target} PROPERTIES
    PREFIX ""
    OUTPUT_NAME "${M_NAME}"
    DEBUG_POSTFIX ""
    RUNTIME_OUTPUT_DIRECTORY "${resource}"
    LIBRARY_OUTPUT_DIRECTORY "${resource}"
    ARCHIVE_OUTPUT_DIRECTORY "${resource}"
    FOLDER modules)
  if(TARGET worldserver)
    add_dependencies(worldserver ${target})
  endif()

  set(copy_commands COMMAND ${CMAKE_COMMAND} -E make_directory "${resource}/conf"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${M_MANIFEST}" "${resource}/module.json")
  foreach(config IN LISTS M_CONFIG)
    list(APPEND copy_commands COMMAND ${CMAKE_COMMAND} -E copy_if_different "${config}" "${resource}/conf/")
  endforeach()
  foreach(sql IN LISTS M_SQL)
    get_filename_component(dir "${sql}" DIRECTORY)
    get_filename_component(db "${dir}" NAME)
    list(APPEND copy_commands COMMAND ${CMAKE_COMMAND} -E make_directory "${resource}/sql/${db}"
      COMMAND ${CMAKE_COMMAND} -E copy_if_different "${sql}" "${resource}/sql/${db}/")
  endforeach()
  add_custom_target(${target}_resources ${copy_commands} VERBATIM)
  add_dependencies(${target} ${target}_resources)
  if(WIN32)
    set(install_base "modules/${M_NAME}")
  else()
    set(install_base "bin/modules/${M_NAME}")
  endif()
  install(TARGETS ${target} RUNTIME DESTINATION "${install_base}" LIBRARY DESTINATION "${install_base}")
  install(FILES "${M_MANIFEST}" DESTINATION "${install_base}" RENAME module.json)
  if(M_CONFIG)
    install(FILES ${M_CONFIG} DESTINATION "${install_base}/conf")
  endif()
  foreach(sql IN LISTS M_SQL)
    get_filename_component(dir "${sql}" DIRECTORY)
    get_filename_component(db "${dir}" NAME)
    install(FILES "${sql}" DESTINATION "${install_base}/sql/${db}")
  endforeach()
endfunction()
